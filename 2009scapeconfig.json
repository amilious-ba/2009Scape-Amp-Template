[
    {
        "DisplayName": "Log Level",
        "Description": "How verbose the server console logs are. verbose = everything; detailed = hides fine/debug spam; cautious = warnings and errors only; silent = errors only.",
        "Category": "Server:settings",
        "FieldName": "server_log_level",
        "InputType": "enum",
        "ParamFieldName": "server_log_level",
        "DefaultValue": "verbose",
        "EnumValues": {
            "verbose": "Verbose",
            "detailed": "Detailed",
            "cautious": "Cautious",
            "silent": "Silent"
        },
        "Subcategory": "Logging & process:article:4"
    },
    {
        "DisplayName": "Secret Key",
        "Description": "Shared secret sent by the client on login. Client and server MUST match or connections are refused. Use the same value in the client Local server profile. Change this if the server is exposed beyond a trusted network.",
        "Category": "Server:settings",
        "FieldName": "server_secret_key",
        "InputType": "text",
        "ParamFieldName": "server_secret_key",
        "DefaultValue": "2009scape_development",
        "Subcategory": "Logging & process:article:4"
    },
    {
        "DisplayName": "Write Logs",
        "Description": "Write server logs to disk under the configured logs path. Disable to reduce disk I/O on quiet private servers.",
        "Category": "Server:settings",
        "FieldName": "server_write_logs",
        "InputType": "checkbox",
        "ParamFieldName": "server_write_logs",
        "DefaultValue": "true",
        "Subcategory": "Logging & process:article:4"
    },
    {
        "DisplayName": "Management Server IP",
        "Description": "IP address of the management server (msip). Use 127.0.0.1 when everything runs on the same host.",
        "Category": "Server:settings",
        "FieldName": "server_msip",
        "InputType": "text",
        "ParamFieldName": "server_msip",
        "DefaultValue": "127.0.0.1",
        "Subcategory": "Network:lan:3"
    },
    {
        "DisplayName": "Preload Map",
        "Description": "Load the full map into memory at startup. Uses about 2GB extra RAM but makes game ticks smoother. Only enable if the host has spare memory.",
        "Category": "Server:settings",
        "FieldName": "server_preload_map",
        "InputType": "checkbox",
        "ParamFieldName": "server_preload_map",
        "DefaultValue": "false",
        "Subcategory": "Logging & process:article:4"
    },
    {
        "DisplayName": "Use Authentication",
        "Description": "Require correct passwords (hashed and stored in the database). PRODUCTION: set true for any multi-user or public host. If false, password correctness is ignored. Requires a working database.",
        "Category": "Server:settings",
        "FieldName": "server_use_auth",
        "InputType": "checkbox",
        "ParamFieldName": "server_use_auth",
        "DefaultValue": "false",
        "Subcategory": "Authentication:lock:1"
    },
    {
        "DisplayName": "Persist Accounts",
        "Description": "Save account metadata (credits, playtime, rights, etc.) to the database. Does NOT affect character saves like stats or inventory (those are always files). PRODUCTION: set true. Requires a working database.",
        "Category": "Server:settings",
        "FieldName": "server_persist_accounts",
        "InputType": "checkbox",
        "ParamFieldName": "server_persist_accounts",
        "DefaultValue": "false",
        "Subcategory": "Authentication:lock:1"
    },
    {
        "DisplayName": "No-Auth Default Admin",
        "Description": "When Use Authentication is off, give every player admin rights by default. Useful for single-player testing. PRODUCTION / shared servers: turn this off (and turn Use Authentication on).",
        "Category": "Server:settings",
        "FieldName": "server_noauth_default_admin",
        "InputType": "checkbox",
        "ParamFieldName": "server_noauth_default_admin",
        "DefaultValue": "true",
        "Subcategory": "Authentication:lock:1"
    },
    {
        "DisplayName": "Daily Accounts Per IP",
        "Description": "Maximum number of different accounts a single IP can log into per day. Helps limit multi-accounting from one connection.",
        "Category": "Server:settings",
        "FieldName": "server_daily_accounts_per_ip",
        "InputType": "number",
        "ParamFieldName": "server_daily_accounts_per_ip",
        "DefaultValue": "3",
        "Subcategory": "Authentication:lock:1"
    },
    {
        "DisplayName": "Watchdog Enabled",
        "Description": "Periodically check external URLs to detect if the host is offline. Disable if you do not want outbound connectivity checks or see false offline warnings.",
        "Category": "Server:settings",
        "FieldName": "server_watchdog_enabled",
        "InputType": "checkbox",
        "ParamFieldName": "server_watchdog_enabled",
        "DefaultValue": "true",
        "Subcategory": "Network:lan:3"
    },
    {
        "DisplayName": "Connectivity Check URLs",
        "Description": "Comma-separated list of URLs the watchdog pings (e.g. https://google.com,https://2009scape.org). Only used when Watchdog is enabled.",
        "Category": "Server:settings",
        "FieldName": "server_connectivity_check_url",
        "InputType": "text",
        "ParamFieldName": "server_connectivity_check_url",
        "DefaultValue": "https://google.com,https://2009scape.org",
        "Subcategory": "Network:lan:3"
    },
    {
        "DisplayName": "Connectivity Timeout (ms)",
        "Description": "How long (milliseconds) the watchdog waits for each URL. Raise this (e.g. 2000\u20135000) if you see false 'Are we offline?' messages.",
        "Category": "Server:settings",
        "FieldName": "server_connectivity_timeout",
        "InputType": "number",
        "ParamFieldName": "server_connectivity_timeout",
        "DefaultValue": "500",
        "Subcategory": "Network:lan:3"
    },
    {
        "DisplayName": "WebSocket Enabled",
        "Description": "Enable a WebSocket listener for browser clients. Uses the same binary game protocol as TCP; each binary frame is treated as a byte chunk.",
        "Category": "Server:settings",
        "FieldName": "server_websocket_enabled",
        "InputType": "checkbox",
        "ParamFieldName": "server_websocket_enabled",
        "DefaultValue": "false",
        "Subcategory": "Network:lan:3"
    },
    {
        "DisplayName": "WebSocket Port",
        "Description": "WebSocket listen port. Leave at 0 to use the default of 53594 + world_id (world 1 = 53595).",
        "Category": "Server:settings",
        "FieldName": "server_websocket_port",
        "InputType": "number",
        "ParamFieldName": "server_websocket_port",
        "DefaultValue": "0",
        "Subcategory": "Network:lan:3"
    },
    {
        "DisplayName": "WebSocket TLS Enabled",
        "Description": "Enable TLS on the WebSocket listener so browser clients can connect with wss:// (required for many PWA/HTTPS setups).",
        "Category": "Server:settings",
        "FieldName": "server_websocket_tls_enabled",
        "InputType": "checkbox",
        "ParamFieldName": "server_websocket_tls_enabled",
        "DefaultValue": "false",
        "Subcategory": "Network:lan:3"
    },
    {
        "DisplayName": "WebSocket TLS Keystore Path",
        "Description": "Path to a PKCS12 keystore for WebSocket TLS, e.g. certs/dev-wss.p12. Only needed when WebSocket TLS is enabled.",
        "Category": "Server:settings",
        "FieldName": "server_websocket_tls_keystore_path",
        "InputType": "text",
        "ParamFieldName": "server_websocket_tls_keystore_path",
        "DefaultValue": "",
        "Subcategory": "Network:lan:3"
    },
    {
        "DisplayName": "WebSocket TLS Keystore Password",
        "Description": "Password for the PKCS12 keystore. Leave blank if the keystore was exported with an empty password.",
        "Category": "Server:settings",
        "FieldName": "server_websocket_tls_keystore_password",
        "InputType": "password",
        "ParamFieldName": "server_websocket_tls_keystore_password",
        "DefaultValue": "",
        "Subcategory": "Network:lan:3"
    },
    {
        "DisplayName": "Database Name",
        "Description": "MySQL/MariaDB database name used for auth and account persistence (often global). Must exist and contain the imported schema before enabling auth.",
        "Category": "Server:settings",
        "FieldName": "database_database_name",
        "InputType": "text",
        "ParamFieldName": "database_database_name",
        "DefaultValue": "global",
        "Subcategory": "Database:storage:2"
    },
    {
        "DisplayName": "Database Username",
        "Description": "Database user the server connects as. Needs full access to the configured database.",
        "Category": "Server:settings",
        "FieldName": "database_database_username",
        "InputType": "text",
        "ParamFieldName": "database_database_username",
        "DefaultValue": "root",
        "Subcategory": "Database:storage:2"
    },
    {
        "DisplayName": "Database Password",
        "Description": "Password for the database user. Leave empty only for local root with no password (not recommended).",
        "Category": "Server:settings",
        "FieldName": "database_database_password",
        "InputType": "password",
        "ParamFieldName": "database_database_password",
        "DefaultValue": "",
        "Subcategory": "Database:storage:2"
    },
    {
        "DisplayName": "Database Address",
        "Description": "Hostname or IP of the database server. Use 127.0.0.1 when MariaDB is on the same machine as AMP.",
        "Category": "Server:settings",
        "FieldName": "database_database_address",
        "InputType": "text",
        "ParamFieldName": "database_database_address",
        "DefaultValue": "127.0.0.1",
        "Subcategory": "Database:storage:2"
    },
    {
        "DisplayName": "Database Port",
        "Description": "Database port (default MySQL/MariaDB is 3306). Stored as a string in the server config.",
        "Category": "Server:settings",
        "FieldName": "database_database_port",
        "InputType": "text",
        "ParamFieldName": "database_database_port",
        "DefaultValue": "3306",
        "Subcategory": "Database:storage:2"
    },
