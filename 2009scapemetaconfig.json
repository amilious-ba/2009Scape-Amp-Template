[
    {
        "ConfigFile": "config/default.conf",
        "ConfigType": "ini",
        "AutoMap": true,
        "Importable": true,
        "ConfigFormat": "{0} = {1}",
        "Subsections": [
            {
                "Heading": "server",
                "SettingMappings": {
                    "LogLevel": "log_level",
                    "SecretKey": "secret_key",
                    "UseAuth": "use_auth",
                    "PersistAccounts": "persist_accounts",
                    "NoAuthDefaultAdmin": "noauth_default_admin",
                    "WatchdogEnabled": "watchdog_enabled",
                    "ConnectivityTimeout": "connectivity_timeout",
                    "PreloadMap": "preload_map"
                }
            },
            {
                "Heading": "database",
                "SettingMappings": {
                    "DatabaseName": "database_name",
                    "DatabaseUsername": "database_username",
                    "DatabasePassword": "database_password",
                    "DatabaseAddress": "database_address",
                    "DatabasePort": "database_port"
                }
            },
            {
                "Heading": "world",
                "SettingMappings": {
                    "WorldName": "name",
                    "WorldId": "world_id",
                    "Members": "members",
                    "Activity": "activity",
                    "Pvp": "pvp",
                    "WildPvp": "wild_pvp_enabled",
                    "EnableBots": "enable_bots",
                    "Debug": "debug",
                    "Dev": "dev",
                    "XpRates": "xp_rates",
                    "Ironman": "ironman",
                    "PlayerCommands": "player_commands",
                    "IWantToCheat": "i_want_to_cheat",
                    "SkillcapePerks": "skillcape_perks",
                    "SecondBank": "second_bank",
                    "EnableGlobalChat": "enable_global_chat"
                }
            }
        ]
    }
]
