[
    {
        "ConfigFile": "config/default.conf",
        "ConfigType": "ini",
        "AutoMap": false,
        "Importable": true,
        "ConfigFormat": "{0} = {1}",
        "ConfigFormatRegex": "^(?<key>[^=]+?)\\s*=\\s*(?<value>.*?)$",
        "Subsections": [
            {
                "Heading": "server",
                "SettingMappings": {
                    "log_level": "LogLevel",
                    "secret_key": "SecretKey",
                    "use_auth": "UseAuth",
                    "persist_accounts": "PersistAccounts",
                    "noauth_default_admin": "NoAuthDefaultAdmin",
                    "watchdog_enabled": "WatchdogEnabled",
                    "connectivity_timeout": "ConnectivityTimeout",
                    "preload_map": "PreloadMap"
                }
            },
            {
                "Heading": "database",
                "SettingMappings": {
                    "database_name": "DatabaseName",
                    "database_username": "DatabaseUsername",
                    "database_password": "DatabasePassword",
                    "database_address": "DatabaseAddress",
                    "database_port": "DatabasePort"
                }
            },
            {
                "Heading": "world",
                "SettingMappings": {
                    "name": "WorldName",
                    "world_id": "WorldId",
                    "members": "Members",
                    "activity": "Activity",
                    "pvp": "Pvp",
                    "wild_pvp_enabled": "WildPvp",
                    "enable_bots": "EnableBots",
                    "debug": "Debug",
                    "dev": "Dev",
                    "xp_rates": "XpRates",
                    "ironman": "Ironman",
                    "player_commands": "PlayerCommands",
                    "i_want_to_cheat": "IWantToCheat",
                    "skillcape_perks": "SkillcapePerks",
                    "second_bank": "SecondBank",
                    "enable_global_chat": "EnableGlobalChat"
                }
            }
        ]
    }
]
